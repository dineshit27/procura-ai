# Procura AI Root Environment Configuration
# Copy this file to individual client and server folders as needed.

# Backend Configuration (see server/.env.example)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# PayPal REST API Configuration (see server/.env.example)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# PAYPAL_PAYEE_EMAIL must be a US-country Sandbox Business account email for USD payments
# PAYPAL_PAYEE_EMAIL=sb-xxxxxxx@business.example.com

# Frontend Configuration (see client/.env.example)
VITE_API_URL=http://localhost:5000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Optional public identifiers for isolated demo users; see client/.env.example.
# Passwords must never be stored in VITE_* variables.
# VITE_DEMO_ADMIN_EMAIL=demo.admin@example.com
# VITE_DEMO_PROCUREMENT_EMAIL=demo.procurement@example.com
# VITE_DEMO_FINANCE_EMAIL=demo.finance@example.com
# VITE_DEMO_REQUESTER_EMAIL=demo.requester@example.com

# Server only — never expose or commit this value.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# INITIAL_ADMIN_EMAIL=verified.admin@example.com
# INITIAL_ADMIN_SETUP_CONFIRM=assign-initial-admin

