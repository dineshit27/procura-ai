# API backend URL (used by Vite dev proxy and direct calls)
VITE_API_URL=http://localhost:5000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Optional: disposable demo accounts. Email identifiers are public. Passwords,
# if supplied, are also public and must only belong to isolated demo users.
# VITE_DEMO_ADMIN_EMAIL=demo.admin@example.com
# VITE_DEMO_ADMIN_PASSWORD=public-demo-password
# VITE_DEMO_PROCUREMENT_EMAIL=demo.procurement@example.com
# VITE_DEMO_PROCUREMENT_PASSWORD=public-demo-password
# VITE_DEMO_FINANCE_EMAIL=demo.finance@example.com
# VITE_DEMO_FINANCE_PASSWORD=public-demo-password
# VITE_DEMO_REQUESTER_EMAIL=demo.requester@example.com
# VITE_DEMO_REQUESTER_PASSWORD=public-demo-password
