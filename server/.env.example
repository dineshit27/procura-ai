# Server Port
PORT=5000

# Environment Mode: development | test | production
NODE_ENV=development

# Allowed CORS Origin for Client
CLIENT_URL=http://localhost:5173

# Supabase authentication. SERVICE_ROLE_KEY must exist only on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Used only by the one-time, server-side setup command. Never set this in the browser.
# INITIAL_ADMIN_EMAIL=verified.admin@example.com

# Google Gemini API Configuration (Phase 3 AI Purchasing Intelligence)
# Get your API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# PayPal REST API Configuration (Sandbox / Production)
# Get your credentials from the PayPal Developer Dashboard: https://developer.paypal.com/dashboard/applications/sandbox
# If omitted, the application runs normally with PayPal checkout disabled.
# Default base URL is https://api-m.sandbox.paypal.com (use https://api-m.paypal.com for live production).
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# CRITICAL for USD Sandbox payments:
# PAYPAL_PAYEE_EMAIL must be set to the email of a Sandbox Business account
# created with Country = United States. If your sandbox Business account was
# created for a non-US country (e.g. India), buyers will see:
#   "This seller doesn't accept payments in your currency."
# To fix: go to https://developer.paypal.com/dashboard/accounts,
# create a Sandbox Business account with Country = United States,
# then set PAYPAL_PAYEE_EMAIL to that account's email address below.
# PAYPAL_PAYEE_EMAIL=sb-xxxxxxx@business.example.com
